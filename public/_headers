/*
  Content-Security-Policy: default-src 'self'; script-src 'self' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: blob: https://upload.wikimedia.org https://thumb.wikimedia.org https://iiif.archive.org https://*.loc.gov; connect-src 'self' https://cloudflareinsights.com; worker-src 'self' blob:; frame-ancestors 'self'; base-uri 'self'; form-action 'none'; object-src 'none'; upgrade-insecure-requests
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Cross-Origin-Opener-Policy: same-origin

# Versioned by tools/deploy.sh (?v=<release>): browsers and the edge keep these for a year
/app.js
  Cache-Control: public, max-age=31536000, immutable
/style.css
  Cache-Control: public, max-age=31536000, immutable
/data/*
  Cache-Control: public, max-age=31536000, immutable

# Fonts and the map libraries, served from the site. A font file never changes under its name (a new version gets a new
# name); the libraries carry ?v=<hash of the file> on their script tags (tools/vendor.sh)
/fonts/*.woff2
  Cache-Control: public, max-age=31536000, immutable
/vendor/*
  Cache-Control: public, max-age=31536000, immutable
# The font stylesheets have no version on their links, so a day
/fonts/*.css
  Cache-Control: public, max-age=86400

# Share pictures (tools/og.mjs): redrawn under the same name when a page's content changes, so a day
/og/*
  Cache-Control: public, max-age=86400

# Icons change rarely
/*.png
  Cache-Control: public, max-age=2592000
/favicon.ico
  Cache-Control: public, max-age=2592000
